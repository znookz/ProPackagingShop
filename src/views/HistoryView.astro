---
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import CtaBand from '../components/CtaBand.astro';
import { getDict, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = getDict(lang).history;
---
<Base lang={lang} page="history">
  <!-- INTRO -->
  <section class="wrap flex flex-wrap items-center gap-8 py-8 md:gap-12 md:py-16">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col gap-3.5 md:gap-4">
      <span class="kicker">{h.kicker}</span>
      <h1 class="display text-balance text-[2.125rem] leading-[1.4] md:text-[3.5rem] md:leading-[1.3]">{h.title}</h1>
      <p class="muted m-0 max-w-[30em] text-pretty text-base md:text-lg">{h.intro}</p>
    </div>
    <div class="blueprint min-w-0 flex-[1_1_26rem] p-2 md:p-3.5">
      <Corners />
      <div class="ph aspect-[4/3]"><span>{h.photoMain}</span></div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="wrap flex flex-col gap-5 py-8 md:gap-8 md:py-12">
    <div class="flex flex-col gap-1">
      <span class="kicker">{h.timelineKicker}</span>
      <h2 class="display text-[1.75rem] leading-snug md:text-[2.5rem]">{h.timelineTitle}</h2>
    </div>
    <ol class="m-0 ml-1.5 flex list-none flex-col gap-6 border-l-[1.5px] border-dashed border-accent-700 p-0 md:ml-2 md:gap-0">
      {h.timeline.map((item, i) => (
        <li class="relative flex flex-wrap gap-x-10 gap-y-0 pl-[1.375rem] md:py-2 md:pb-9 md:pl-8">
          <span
            aria-hidden="true"
            class:list={[
              'absolute -left-2 top-3 size-3.5 border-[1.5px] border-accent-700 md:top-4',
              i === h.timeline.length - 1 ? 'bg-accent-700' : 'bg-bg',
            ]}
          ></span>
          <span class="display basis-full text-[2.125rem] leading-snug text-accent-700 md:basis-[8.75rem] md:text-[2.75rem]">{item.year}</span>
          <div class="min-w-0 flex-[1_1_20rem]">
            <h3 class="display text-[1.1875rem] leading-normal md:text-2xl">{item.title}</h3>
            <p class="muted m-0 text-[0.9375rem] md:text-[1.0625rem]">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- VALUES -->
  <section class="wrap flex flex-col gap-5 py-8 md:gap-7 md:py-12">
    <div class="flex flex-col gap-1">
      <span class="kicker">{h.valuesKicker}</span>
      <h2 class="display text-[1.75rem] leading-snug md:text-[2.5rem]">{h.valuesTitle}</h2>
    </div>
    <div class="blueprint">
      <Corners />
      <div class="cells grid-cols-1 md:grid-cols-3">
        {h.values.map((v, i) => (
          <div class="flex flex-col gap-1.5 px-[1.125rem] pb-[1.375rem] pt-5 md:px-6 md:pb-8 md:pt-7">
            <span class="display text-lg text-accent-700 md:text-xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display text-[1.3125rem] leading-normal md:text-2xl">{v.title}</h3>
            <p class="muted m-0 text-[0.9375rem]">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="wrap flex flex-col gap-5 py-8 md:gap-7 md:py-12">
    <div class="flex flex-col gap-1">
      <span class="kicker">{h.galleryKicker}</span>
      <h2 class="display text-[1.75rem] leading-snug md:text-[2.5rem]">{h.galleryTitle}</h2>
    </div>
    <div class="grid grid-cols-2 gap-3.5 md:grid-cols-3 md:gap-5">
      {h.gallery.map((label) => (
        <div class="blueprint p-1.5 md:p-2.5">
          <Corners />
          <div class="ph aspect-square p-1 md:aspect-[4/3]"><span>{label}</span></div>
        </div>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} title={h.cta.title} body={h.cta.body} />
</Base>
