---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import Dieline from '../components/Dieline.astro';
import CtaBand from '../components/CtaBand.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductViewer from '../components/ProductViewer.astro';
import { getDict, pagePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const h = t.home;
const featured = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => ['tuck-box', 'rigid-box', 'shipper-box', 'hang-tag', 'sticker', 'desk-calendar'].includes(p.id));
---
<Base lang={lang} page="home">
  <!-- HERO -->
  <section class="wrap flex flex-wrap items-center gap-10 py-10 md:gap-12 md:pb-20 md:pt-[4.5rem]">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col items-start gap-5 md:gap-6">
      <span class="tag">{h.kicker}</span>
      <h1 class="display text-balance text-[2.5rem] leading-[1.3] md:text-[4.25rem] md:leading-[1.25]">
        {h.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h1>
      <p class="muted m-0 max-w-[30em] text-pretty text-[1.0625rem] md:text-xl">{h.sub}</p>
      <div class="mt-1 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={pagePath(lang, 'contact') + '#quote'} class="btn btn-primary blueprint">
          {t.cta.quote}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          <Corners />
        </a>
        <a href={pagePath(lang, 'product')} class="btn">{t.cta.viewAll}</a>
      </div>
    </div>
    <figure class="blueprint m-0 flex min-w-0 flex-[1_1_24rem] flex-col px-3.5 pb-11 pt-5 md:px-7 md:pb-14 md:pt-8">
      <Corners />
      <Dieline alt={h.figAlt} />
      <figcaption class="absolute inset-x-3.5 bottom-2.5 flex justify-between gap-2 text-xs text-neutral-700 md:inset-x-5 md:bottom-3 md:text-[0.8125rem]">
        <span>{h.figLeft}</span><span>{h.figRight}</span>
      </figcaption>
    </figure>
  </section>

  <!-- TRUST STRIP -->
  <section class="wrap pb-6">
    <div class="blueprint">
      <Corners />
      <div class="cells grid-cols-2 md:grid-cols-4">
        {h.trust.map((item) => (
          <div class="flex flex-col px-3.5 py-4 md:px-6 md:py-6">
            <span class="display text-[2rem] leading-snug text-accent-700 md:text-[2.75rem]">{item.value}</span>
            <span class="muted text-sm md:text-[0.9375rem]">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="wrap flex flex-col gap-5 pb-12 pt-12 md:gap-9 md:pb-16 md:pt-[4.5rem]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-1.5">
        <span class="kicker">{h.service.kicker}</span>
        <h2 class="display text-[1.875rem] leading-snug md:text-[2.625rem]">{h.service.title}</h2>
      </div>
      <p class="muted m-0 max-w-[28em] text-base">{h.service.sub}</p>
    </div>
    <div class="blueprint">
      <Corners />
      <div class="cells grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {t.services.map((s, i) => (
          <div class="flex flex-col gap-1.5 px-[1.125rem] pb-[1.375rem] pt-5 lg:min-h-[14rem] lg:px-6 lg:pb-8 lg:pt-7">
            <span class="display text-lg text-accent-700 lg:text-xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display text-[1.3125rem] leading-normal lg:text-[1.375rem]">{s.title}</h3>
            <p class="muted m-0 text-[0.9375rem]">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="mr-1.5 text-[0.9375rem] font-semibold">{h.finishLabel}</span>
      {t.finishes.map((f) => <span class="tag tag-neutral">{f}</span>)}
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products" class="wrap flex flex-col gap-5 py-10 md:gap-9 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-1.5">
        <span class="kicker">{h.product.kicker}</span>
        <h2 class="display text-[1.875rem] leading-snug md:text-[2.625rem]">{h.product.title}</h2>
      </div>
      <a href={pagePath(lang, 'product')} class="btn hidden md:inline-flex">{t.cta.viewAll}</a>
    </div>
    <div class="grid grid-cols-2 gap-3.5 md:grid-cols-3 md:gap-6">
      {featured.map((p) => <ProductCard lang={lang} product={p} />)}
    </div>
    <a href={pagePath(lang, 'product')} class="btn btn-block md:hidden">{t.cta.viewAll}</a>
  </section>

  <!-- PROCESS -->
  <section id="process" class="wrap flex flex-col gap-5 py-10 md:gap-9 md:py-16">
    <div class="flex flex-col gap-1.5">
      <span class="kicker">{h.process.kicker}</span>
      <h2 class="display text-[1.875rem] leading-snug md:text-[2.625rem]">{h.process.title}</h2>
    </div>
    <ol class="m-0 grid list-none gap-5 border-accent-700 p-0 max-md:border-l-[1.5px] max-md:border-dashed max-md:pl-5 md:grid-cols-4 md:gap-0 md:border-t-[1.5px] md:border-dashed">
      {t.process.map((step, i) => (
        <li class="flex flex-col md:pr-6 md:pt-6">
          <span class="display text-[2.375rem] leading-snug text-accent-700 md:text-[3.25rem]">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="display text-[1.1875rem] leading-normal md:text-[1.3125rem]">{step.title}</h3>
          <p class="muted m-0 text-[0.9375rem]">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <CtaBand lang={lang} showContactLine />
  <ProductViewer lang={lang} />
</Base>
